#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["boto3==1.43.108"]
# [tool.uv]
# exclude-newer = "2026-10-04T00:00:00Z"
# ///
"""Run the model upload on the uploader instance and wait for it to finish.

Sets the uploader Auto Scaling group to 1. The instance downloads the pinned
model from Hugging Face inside the region, copies it to the weights bucket,
writes the .complete marker and sets the group back to 0.

Reads terraform outputs (region, weights_bucket, uploader_asg_name, model_name,
model_revision); flags override them. Needs AWS_PROFILE set explicitly.

The weights bucket denies object access to everyone but the workload roles, so
progress is read from the uploader's serial console (it logs JSON events there)
rather than from S3. Needs ec2:GetConsoleOutput and Auto Scaling access.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import boto3
from _common import confirm, require_profile, terraform_outputs
from botocore.exceptions import ClientError

POLL_S = 30


DONE_MESSAGES = {"wrote completion marker", "already uploaded; nothing to do"}


def console_events(ec2, instance_id: str) -> list[dict]:
    """JSON events the uploader printed to the serial console, oldest first."""
    try:
        raw = ec2.get_console_output(InstanceId=instance_id, Latest=True).get("Output") or ""
    except ClientError:
        return []
    # botocore already base64-decodes GetConsoleOutput.
    events = []
    for line in raw.splitlines():
        start = line.find('{"')
        if start < 0:
            continue
        try:
            event = json.loads(line[start:])
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict) and "msg" in event:
            events.append(event)
    return events


def print_uploader_log(logs, group: str, stream: str, tail: int = 40) -> None:
    """The uploader ships its log here on exit. Show the end of it."""
    print(f"uploader {stream} exited without a completion event; last lines of {group}/{stream}:", file=sys.stderr)
    time.sleep(10)  # put_log_events is eventually consistent
    try:
        events = logs.get_log_events(logGroupName=group, logStreamName=stream, startFromHead=False, limit=tail)
    except ClientError as exc:
        print(f"  (no log: {exc.response['Error']['Code']})", file=sys.stderr)
        return
    for event in events["events"]:
        print(f"  {event['message']}", file=sys.stderr)


def group_state(autoscaling, name: str) -> str:
    groups = autoscaling.describe_auto_scaling_groups(AutoScalingGroupNames=[name])["AutoScalingGroups"]
    if not groups:
        sys.exit(f"error: Auto Scaling group {name} not found")
    group = groups[0]
    instances = ", ".join(f"{i['InstanceId']}:{i['LifecycleState']}" for i in group["Instances"]) or "none"
    return f"desired={group['DesiredCapacity']} instances={instances}"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--region")
    parser.add_argument("--bucket")
    parser.add_argument("--asg")
    parser.add_argument("--model-name")
    parser.add_argument("--revision")
    parser.add_argument("--timeout-min", type=int, default=90)
    parser.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    args = parser.parse_args()

    profile = require_profile()
    outputs = terraform_outputs()
    region = args.region or outputs.get("region")
    bucket = args.bucket or outputs.get("weights_bucket")
    asg = args.asg or outputs.get("uploader_asg_name")
    model_name = args.model_name or outputs.get("model_name")
    revision = args.revision or outputs.get("model_revision")
    required = {"region": region, "bucket": bucket, "asg": asg, "model-name": model_name, "revision": revision}
    missing = [name for name, value in required.items() if not value]
    if missing:
        sys.exit(f"error: missing {', '.join(missing)} (no terraform outputs; pass the flags)")

    session = boto3.Session(profile_name=profile, region_name=region)
    identity = session.client("sts").get_caller_identity()
    print(f"profile {profile} -> account {identity['Account']} ({identity['Arn']})")

    autoscaling = session.client("autoscaling")
    ec2 = session.client("ec2")
    log_group = outputs.get("uploader_log_group") or "/qwen-spot/uploader"
    target = f"s3://{bucket}/models/{model_name}/{revision}/"

    confirm(f"Start uploader {asg} in {region} to fetch {model_name}@{revision[:12]} into {target}?", args.yes)
    autoscaling.set_desired_capacity(AutoScalingGroupName=asg, DesiredCapacity=1, HonorCooldown=False)
    print(f"uploader {asg} set to 1; following its console log")

    deadline = time.monotonic() + args.timeout_min * 60
    seen: set[str] = set()
    instance_id = None
    try:
        while time.monotonic() < deadline:
            groups = autoscaling.describe_auto_scaling_groups(AutoScalingGroupNames=[asg])["AutoScalingGroups"]
            instances = groups[0]["Instances"] if groups else []
            if instances:
                instance_id = instances[0]["InstanceId"]
            elif instance_id and groups and groups[0]["DesiredCapacity"] == 0:
                # The uploader scaled itself to 0 without a completion event we saw.
                print_uploader_log(session.client("logs"), log_group, instance_id)
                return 1
            if instance_id:
                for event in console_events(ec2, instance_id):
                    key = json.dumps(event, sort_keys=True)
                    if key in seen:
                        continue
                    seen.add(key)
                    fields = {k: v for k, v in event.items() if k not in {"ts", "level", "msg"}}
                    print(f"  [{event.get('level', 'info')}] {event['msg']} {json.dumps(fields) if fields else ''}")
                    if event["msg"] in DONE_MESSAGES:
                        print(f"done: {target}")
                        return 0
                    if event.get("level") == "error":
                        print("upload failed on the instance; it scales itself to 0", file=sys.stderr)
                        return 1
            print(f"{time.strftime('%H:%M:%S')} {group_state(autoscaling, asg)}")
            time.sleep(POLL_S)
    except KeyboardInterrupt:
        print("interrupted; the uploader keeps running and scales itself to 0 when finished")
        return 130

    print(f"timed out after {args.timeout_min} min; setting {asg} to 0 to stop spend", file=sys.stderr)
    autoscaling.set_desired_capacity(AutoScalingGroupName=asg, DesiredCapacity=0, HonorCooldown=False)
    return 1


if __name__ == "__main__":
    sys.exit(main())
