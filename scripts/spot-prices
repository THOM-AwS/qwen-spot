#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["boto3==1.43.108"]
# [tool.uv]
# exclude-newer = "2026-10-04T00:00:00Z"
# ///
"""Print current Linux spot prices for instance types across every enabled region.

Read-only. Defaults to the instance_types terraform output, else p5.4xlarge.
"""

from __future__ import annotations

import argparse
import json
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import UTC, datetime
from pathlib import Path
from typing import NamedTuple

sys.path.insert(0, str(Path(__file__).resolve().parent))

import boto3
from _common import terraform_outputs
from botocore.exceptions import BotoCoreError, ClientError


class Price(NamedTuple):
    usd: float
    instance_type: str
    zone: str
    region: str


def region_prices(session: boto3.Session, region: str, types: list[str]) -> list[Price]:
    ec2 = session.client("ec2", region_name=region)
    prices: list[Price] = []
    try:
        pages = ec2.get_paginator("describe_spot_price_history").paginate(
            InstanceTypes=types,
            ProductDescriptions=["Linux/UNIX"],
            StartTime=datetime.now(UTC),
        )
        for page in pages:
            prices.extend(
                Price(float(p["SpotPrice"]), p["InstanceType"], p["AvailabilityZone"], region)
                for p in page["SpotPriceHistory"]
            )
    except (BotoCoreError, ClientError) as exc:
        print(f"warning: {region}: {exc}", file=sys.stderr)
    return prices


def on_demand_price(session: boto3.Session, region: str, instance_type: str) -> float | None:
    pricing = session.client("pricing", region_name="us-east-1")
    filters = {
        "instanceType": instance_type,
        "regionCode": region,
        "operatingSystem": "Linux",
        "tenancy": "Shared",
        "preInstalledSw": "NA",
        "capacitystatus": "Used",
    }
    response = pricing.get_products(
        ServiceCode="AmazonEC2",
        Filters=[{"Type": "TERM_MATCH", "Field": k, "Value": v} for k, v in filters.items()],
        MaxResults=1,
    )
    for item in response["PriceList"]:
        for term in json.loads(item)["terms"]["OnDemand"].values():
            for dimension in term["priceDimensions"].values():
                return float(dimension["pricePerUnit"]["USD"])
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--types", nargs="+", help="instance types (default: terraform output or p5.4xlarge)")
    parser.add_argument("--on-demand", action="store_true", help="also show the on-demand price per region")
    parser.add_argument("--limit", type=int, default=0, help="show only the N cheapest")
    args = parser.parse_args()

    types = args.types or terraform_outputs().get("instance_types") or ["p5.4xlarge"]
    session = boto3.Session()
    regions = [r["RegionName"] for r in session.client("ec2", region_name="us-east-1").describe_regions()["Regions"]]

    with ThreadPoolExecutor(max_workers=16) as pool:
        prices = sorted(p for batch in pool.map(lambda r: region_prices(session, r, types), regions) for p in batch)
    if args.limit:
        prices = prices[: args.limit]
    if not prices:
        print(f"no spot prices found for {', '.join(types)}")
        return 1

    on_demand: dict[tuple[str, str], float | None] = {}
    if args.on_demand:
        for key in {(p.region, p.instance_type) for p in prices}:
            on_demand[key] = on_demand_price(session, *key)

    print(f"{'USD/hr':>9}  {'type':<14} {'zone':<18} {'on-demand':>9}")
    for p in prices:
        od = on_demand.get((p.region, p.instance_type))
        od_text = f"{od:9.4f}" if od else "" if not args.on_demand else "      n/a"
        print(f"{p.usd:9.4f}  {p.instance_type:<14} {p.zone:<18} {od_text}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
